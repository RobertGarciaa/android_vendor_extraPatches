diff --git a/src/com/android/settings/nabu/NabuInputPreferenceController.java b/src/com/android/settings/nabu/NabuInputPreferenceController.java
new file mode 100644
index 00000000000..b14ca48c990
--- /dev/null
+++ b/src/com/android/settings/nabu/NabuInputPreferenceController.java
@@ -0,0 +1,15 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+package com.android.settings.nabu;
+import android.content.Context;
+import android.content.ComponentName;
+import android.content.Intent;
+import android.os.SystemProperties;
+import com.android.settings.core.BasePreferenceController;
+public final class NabuInputPreferenceController extends BasePreferenceController {
+ public NabuInputPreferenceController(Context c,String key){super(c,key);}
+ @Override public int getAvailabilityStatus(){
+  if(!SystemProperties.getBoolean("ro.nabu.input_port",false))return UNSUPPORTED_ON_DEVICE;
+  Intent i=new Intent().setComponent(new ComponentName("com.miui.miinput","com.miui.miinput.stylus.KeyBoardAndStylusSettingsActivity"));
+  return i.resolveActivity(mContext.getPackageManager())!=null?AVAILABLE:UNSUPPORTED_ON_DEVICE;
+ }
+}
