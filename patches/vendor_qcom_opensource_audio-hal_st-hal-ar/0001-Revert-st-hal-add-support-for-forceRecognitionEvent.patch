From 83cefd8ec43f4b9a181fceaac640e856fa1ad7e3 Mon Sep 17 00:00:00 2001
From: Bruno Martins <bgcngm@gmail.com>
Date: Sat, 4 Jul 2026 10:08:19 +0100
Subject: [PATCH] Revert "st-hal: add support for forceRecognitionEvent"

This reverts commit 2b73243212e5695839775fe3926909d15795fccd.

Change-Id: I93dfcffa1996210403fd52a15fd9d7460d371ae2
---
 inc/soundtriggerhw/SoundTriggerSession.h   |  2 --
 src/soundtriggerhw/SoundTriggerHw.cpp      | 19 +++----------------
 src/soundtriggerhw/SoundTriggerSession.cpp | 21 ---------------------
 3 files changed, 3 insertions(+), 39 deletions(-)

diff --git a/inc/soundtriggerhw/SoundTriggerSession.h b/inc/soundtriggerhw/SoundTriggerSession.h
index 6bd6966..b4e634e 100644
--- a/inc/soundtriggerhw/SoundTriggerSession.h
+++ b/inc/soundtriggerhw/SoundTriggerSession.h
@@ -39,7 +39,6 @@ public:
     int startRecognition(int32_t deviceHandle, int32_t ioHandle,
                          const RecognitionConfig &config);
     int stopRecognition();
-    int forceRecognitionEvent();
     std::string getModuleVersion();
     SoundModelHandle getSessionHandle() { return mSessionHandle; }
 
@@ -51,7 +50,6 @@ private:
     int startRecognition_l(int32_t deviceHandle, int32_t ioHandle,
                            const RecognitionConfig &config);
     int stopRecognition_l();
-    int forceRecognitionEvent_l();
     void onCallback(uint32_t *eventData);
     void onRecognitionCallback_l(struct pal_st_recognition_event *palEvent);
     void onPhraseRecognitionCallback_l(struct pal_st_phrase_recognition_event *palPhraseEvent);
diff --git a/src/soundtriggerhw/SoundTriggerHw.cpp b/src/soundtriggerhw/SoundTriggerHw.cpp
index 452161b..19b8e57 100644
--- a/src/soundtriggerhw/SoundTriggerHw.cpp
+++ b/src/soundtriggerhw/SoundTriggerHw.cpp
@@ -260,25 +260,12 @@ ScopedAStatus SoundTriggerHw::stopRecognition(int32_t handle)
     return CoreUtils::halErrorToAidl(status);
 }
 
+// TODO implement this API
 ScopedAStatus SoundTriggerHw::forceRecognitionEvent(int32_t handle)
 {
-    int status = 0;
-
-    RETURN_IF_STUB_HAL_ENABLED();
-
-    STHAL_INFO(LOG_TAG, "Enter handle %d", handle);
-
-    auto st_session = getSession(handle);
-    CHECK_VALID_SESSION(st_session, handle, STATUS_INVALID_OPERATION);
-
-    status = st_session->forceRecognitionEvent();
-    if (status != 0) {
-        STHAL_ERR(LOG_TAG, "Failed to force recognition event with handle %d, status %d",
-                                                      handle, status);
-        return CoreUtils::halErrorToAidl(status);
-    }
+    int status = -ENOSYS;
 
-    STHAL_INFO(LOG_TAG, "Exit handle %d, status %d", handle, status);
+    STHAL_INFO(LOG_TAG, "unsupported API");
     return CoreUtils::halErrorToAidl(status);
 }
 
diff --git a/src/soundtriggerhw/SoundTriggerSession.cpp b/src/soundtriggerhw/SoundTriggerSession.cpp
index a8df111..5545b0a 100644
--- a/src/soundtriggerhw/SoundTriggerSession.cpp
+++ b/src/soundtriggerhw/SoundTriggerSession.cpp
@@ -68,12 +68,6 @@ int SoundTriggerSession::stopRecognition()
     return stopRecognition_l();
 }
 
-int SoundTriggerSession::forceRecognitionEvent()
-{
-    std::lock_guard<std::mutex> lock(mSessionMutex);
-    return forceRecognitionEvent_l();
-}
-
 std::string SoundTriggerSession::getModuleVersion()
 {
     int status = 0;
@@ -385,19 +379,4 @@ int SoundTriggerSession::stopRecognition_l()
     return status;
 }
 
-int SoundTriggerSession::forceRecognitionEvent_l()
-{
-    int status = 0;
-
-    STHAL_INFO(LOG_TAG, "Enter, handle %d", mSessionHandle);
-
-    status = pal_stream_set_param(mPalHandle, PAL_PARAM_ID_FORCE_RECOGNITION, nullptr);
-    if (status) {
-        STHAL_ERR(LOG_TAG, "error, failed to force recognition, status = %d", status);
-    }
-
-    STHAL_INFO(LOG_TAG, "Exit, handle %d, status = %d", mSessionHandle, status);
-    return status;
-}
-
 } // namespace aidl::android::hardware::soundtrigger3
-- 
2.55.0

